# ── Health Bot 環境變數 ─────────────────────────────────────────────
# Copy to your host (Zeabur Variables / .env) and fill in real values.
# NEVER commit a real .env or a real token — this repo is public.

# Required: Telegram bot token from @BotFather. The app refuses to start
# without it (no hardcoded fallback). If this token was ever exposed,
# rotate it in @BotFather with /revoke.
BOT_TOKEN=

# Required: Telegram numeric chat id allowed to use the bot (owner). The app
# refuses to start without it — never hardcode it in this public repo.
# Accepts either OWNER_ID or the legacy name OWNER_CHAT_ID.
OWNER_ID=582328026

# Optional: directory for health_data.json / CSV exports.
# /tmp is WIPED on every Zeabur redeploy/restart — point this at a mounted
# persistent volume (e.g. /data) to keep history across deploys.
# Local/dev can leave it unset (falls back to /tmp/hermes_data).
DATA_DIR=/data
